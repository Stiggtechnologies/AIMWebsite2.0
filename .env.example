# =============================================================================
# AIM Website env example
#
# Copy to `.env` (gitignored) and fill in values per environment.
# Only the variables introduced by the Google Ads + intake notification
# work are documented here. Other required vars (Supabase, AIM OS, etc.)
# are documented in PRODUCTION_DEPLOYMENT.md.
# =============================================================================

# --- Supabase ----------------------------------------------------------------
# Public anon key is safe to expose; RLS protects writes. Service-role key
# must NEVER ship to the browser — it bypasses RLS and is used only by
# server-side route handlers (lib/supabase.ts → createServerSupabaseClient).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Analytics: Google Analytics 4 -------------------------------------------
# Existing GA4 measurement ID. Override only if the property changes.
NEXT_PUBLIC_GA_ID=G-PF1ZYXYL6X

# --- Analytics: Google Ads conversion tracking -------------------------------
# Leave blank until the Ads account has conversion actions created.
# When blank the Ads conversion event firers are silent no-ops; GA4 events
# continue to fire normally.
#
# Conversion ID format:   AW-XXXXXXXXXX (10-digit number from Google Ads)
# Conversion label format: alphanumeric token (e.g. aBcD1eFgHiJ) — one per
# conversion action.
#
# Create three conversion actions in Google Ads:
#   1. AIM_Intake_Form_Submit  -> label goes in NEXT_PUBLIC_GOOGLE_ADS_FORM_CONVERSION_LABEL
#   2. AIM_Phone_Click          -> label goes in NEXT_PUBLIC_GOOGLE_ADS_PHONE_CONVERSION_LABEL
#   3. AIM_Booking_Confirm      -> label goes in NEXT_PUBLIC_GOOGLE_ADS_BOOKING_CONVERSION_LABEL
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_FORM_CONVERSION_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_PHONE_CONVERSION_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_BOOKING_CONVERSION_LABEL=

# Currency + default conversion values. Tune to your clinic economics.
NEXT_PUBLIC_ADS_CURRENCY=CAD
NEXT_PUBLIC_ADS_VALUE_PHONE=50
NEXT_PUBLIC_ADS_VALUE_FORM=150
NEXT_PUBLIC_ADS_VALUE_BOOKING=250

# --- AIMOS clinic (website → crm_leads) --------------------------------------
# clinic_id written on every /api/booking/confirm insert. AIMOS RLS
# (pp_user_can_access_clinic) hides rows where clinic_id IS NULL, so a
# missing value makes website leads invisible on the Leads screen.
#
# AIM-EDM-001 / Centre 87 / edmonton-main-hub — only live clinic.
# Default is the production UUID; override only if that AIMOS row changes.
AIM_DEFAULT_CLINIC_ID=28204b3e-1a45-43b1-94b0-dab164a697ed

# --- AIM Performance admin notifications -------------------------------------
# Fired by /api/aim-performance/leads after a successful Supabase insert.
# All channels are env-gated: leave blank to disable.

# Email (active when RESEND_API_KEY above + admin email are both set).
# Comma-separated list — fans out to every address. Useful for sending
# a copy to both an albertainjurymanagement.ca and an aimphysiotherapy.ca
# inbox so a lead can't be missed if one mailbox is down or unwatched.
AIM_PERFORMANCE_ADMIN_EMAIL=aim2recover@albertainjurymanagement.ca,leads@aimphysiotherapy.ca
AIM_PERFORMANCE_NOTIFICATION_FROM=AIM Performance <noreply@aimphysiotherapy.ca>

# SMS for high-intent leads only (paid physiotherapy assessment, WCB /
# insurance / MVA, or employer/workplace program). Twilio implementation
# sketch lives in lib/aim-performance-notifications.ts. Requires all four.
AIM_PERFORMANCE_ADMIN_SMS_PHONE=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=

# CRM task creation (pick one stack). Sketches live alongside the SMS
# sketch in lib/aim-performance-notifications.ts.
HUBSPOT_API_KEY=
GHL_LOCATION_ID=
GHL_API_KEY=

# --- Intake notification webhook --------------------------------------------
# When set, /api/intake/save fires a fire-and-forget POST after a
# successfully *submitted* intake (drafts do not notify). Point this at
# whatever the clinic actually monitors:
#   - Zapier / Make webhook that emails the office inbox
#   - Slack Incoming Webhook
#   - A custom relay
#
# If the receiving system supports signature verification, set the optional
# secret below — it is sent as the X-Webhook-Secret header.
INTAKE_NOTIFICATION_WEBHOOK_URL=
INTAKE_NOTIFICATION_WEBHOOK_SECRET=
INTAKE_NOTIFICATION_TIMEOUT_MS=5000
